<UserControl x:Class="SMS_Search.Views.Panels.ResultsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SMS_Search.Views"
             xmlns:conv="clr-namespace:SMS_Search.Converters"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>
    </UserControl.Resources>
    <Grid>
        <TabControl ItemsSource="{Binding ResultTabs}"
                    SelectedItem="{Binding SelectedResultTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="TabHeader_MouseLeftButtonDown">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename Tab..." Click="RenameTabMenuItem_Click"/>
                                <MenuItem Header="Pin / Unpin Tab" Command="{Binding TogglePinCommand}"/>
                                <MenuItem Header="Close Tab" Command="{Binding CloseCommand}"
                                          Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <ToggleButton IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                      Style="{StaticResource TransparentIconToggleButtonStyle}"
                                      Width="16" Height="16" Margin="0,0,4,0"
                                      ToolTip="Pin tab (new searches open in a new tab)">
                            <Control Width="11" Height="11">
                                <Control.Style>
                                    <Style TargetType="Control">
                                        <Setter Property="Template" Value="{StaticResource Icon_Pin_Unpinned}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Template" Value="{StaticResource Icon_Pin_Pinned}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Control.Style>
                            </Control>
                        </ToggleButton>
                        <TextBlock Text="{Binding Title}"
                                   Visibility="{Binding IsRenaming, Converter={StaticResource BoolToCollapsed}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                 MinWidth="70"
                                 Height="20"
                                 Padding="2,0"
                                 Margin="0,0,6,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="TabRenameBox_KeyDown"
                                 LostKeyboardFocus="TabRenameBox_LostKeyboardFocus"
                                 IsVisibleChanged="TabRenameBox_IsVisibleChanged"/>
                        <Button Content="&#x00D7;"
                                Command="{Binding CloseCommand}"
                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                Background="Transparent" BorderThickness="0" Padding="3,0" FontWeight="Bold"
                                ToolTip="Close tab (Ctrl+W)"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <views:ResultsView DataContext="{Binding ResultsVm}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Button Command="{Binding NewTabCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="20" Height="20" Margin="0,2,4,0" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip="New Results Tab (Ctrl+T)">
            <TextBlock Text="+" FontWeight="Bold" FontSize="13" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
    </Grid>
</UserControl>

