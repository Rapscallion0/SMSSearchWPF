<UserControl x:Class="SMS_Search.Views.Panels.SavedQueriesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SMS_Search.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <controls:ClearableTextBox Grid.Column="0" x:Name="FilterBox" Placeholder="Filter saved queries..."
                                       TextChanged="FilterBox_TextChanged" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1" x:Name="FilterTypeCombo" Height="24" VerticalContentAlignment="Center"
                      Margin="0,0,6,0" SelectionChanged="FilterTypeCombo_SelectionChanged"
                      ToolTip="Filter by query type: All, SQL (SQL Editor queries), or ADV (Advanced Mode queries)"/>
            <ComboBox Grid.Column="2" x:Name="FilterCategoryCombo" Height="24" VerticalContentAlignment="Center"
                      SelectionChanged="FilterCategoryCombo_SelectionChanged"/>
        </Grid>

        <!-- List + Preview -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" x:Name="QueriesListBox"
                     SelectionChanged="QueriesListBox_SelectionChanged"
                     MouseDoubleClick="QueriesListBox_MouseDoubleClick"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3">
                            <Border DockPanel.Dock="Right" Padding="5,1" CornerRadius="3"
                                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Category}" FontSize="10" Opacity="0.8"/>
                            </Border>
                            <Border DockPanel.Dock="Left" Padding="5,1" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdvanced}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding QueryKindLabel}" FontSize="9.5" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdvanced}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"/>

            <TextBox Grid.Row="2" x:Name="PreviewTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     Padding="4"/>
        </Grid>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" x:Name="DeleteButton" Content="Delete" Padding="10,4" Click="DeleteButton_Click" IsEnabled="False"/>
            <Button HorizontalAlignment="Right" x:Name="LoadButton" Content="Load into SQL Editor" Padding="12,4" Click="LoadButton_Click" IsEnabled="False"/>
        </DockPanel>
    </Grid>
</UserControl>
