<Window x:Class="SMS_Search.Views.Windows.LayoutManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SMS_Search.Converters"
        Title="Layout Manager"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Resources/SMS Search.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Startup Behavior -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Startup Layout" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <RadioButton x:Name="RadioLastSession"
                             Content="Use layout saved on close (resume last session)"
                             GroupName="StartupMode"
                             Margin="0,0,0,6"
                             Checked="StartupMode_Changed"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RadioStartupProfile"
                                 Content="Always launch with startup layout:"
                                 GroupName="StartupMode"
                                 VerticalAlignment="Center"
                                 Checked="StartupMode_Changed"/>
                    <TextBlock x:Name="TxtStartupProfileName"
                               Text="Default"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Profiles List + Action Buttons -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MaxHeight="290"
                    Margin="0,0,12,0">
                <ListBox x:Name="LayoutsList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="LayoutsList_SelectionChanged"
                         MouseDoubleClick="LayoutsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrushKey}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Built-in" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="6,0,0,0"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <Border Background="#FFEF6C00"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="6,0,0,0"
                                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Modified" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <Border Background="#FF2E7D32"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="6,0,0,0"
                                            Visibility="{Binding IsStartup, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Startup" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="1">
                <Button x:Name="BtnApply" Content="Apply" Height="28" Margin="0,0,0,8" Click="BtnApply_Click" ToolTip="Apply the selected layout to the workspace"/>
                <Button x:Name="BtnSave" Content="Save Changes" Height="28" Margin="0,0,0,8" Click="BtnSave_Click" ToolTip="Overwrite the selected layout with the current panel &amp; window arrangement"/>
                <Button x:Name="BtnSaveAs" Content="Save As..." Height="28" Margin="0,0,0,8" Click="BtnSaveAs_Click" ToolTip="Save the current panel &amp; window arrangement as a new layout"/>
                <Button x:Name="BtnDuplicate" Content="Duplicate..." Height="28" Margin="0,0,0,8" Click="BtnDuplicate_Click" ToolTip="Create an editable copy of the selected layout"/>
                <Button x:Name="BtnRename" Content="Rename..." Height="28" Margin="0,0,0,8" Click="BtnRename_Click" ToolTip="Rename the selected custom layout"/>
                <Button x:Name="BtnDelete" Content="Delete" Height="28" Margin="0,0,0,12" Click="BtnDelete_Click" ToolTip="Delete the selected custom layout"/>
                <Separator Margin="0,0,0,12"/>
                <Button x:Name="BtnSetStartup" Content="Set as Startup" Height="28" Click="BtnSetStartup_Click" ToolTip="Use the selected layout whenever the application launches"/>
            </StackPanel>
        </Grid>

        <!-- Selected Profile Options -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <CheckBox x:Name="ChkRememberPosition"
                      Content="Remember main window position (Left/Top) for selected layout"
                      Margin="0,0,0,6"
                      Checked="ChkRememberPosition_Changed"
                      Unchecked="ChkRememberPosition_Changed"
                      ToolTip="When checked, applying or starting with this layout also restores the main window's screen position (auto-enabled when all panels are undocked)."/>
            <CheckBox x:Name="ChkPromptOnClose"
                      Content="Prompt to save unsaved changes on close"
                      Margin="0,0,0,8"
                      Checked="ChkPromptOnClose_Changed"
                      Unchecked="ChkPromptOnClose_Changed"
                      ToolTip="When checked, closing the app with unsaved changes to this custom layout asks whether to save them."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Search Tab:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" x:Name="CmbSearchTab" Height="24" Margin="0,0,12,0" SelectionChanged="SearchPref_Changed"
                          ToolTip="Optional Search Tab to select when this layout is applied or used at startup">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Search Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="CmbSearchMode" Height="24" SelectionChanged="SearchPref_Changed"
                          ToolTip="Optional Search Mode (Simple or Advanced) to apply with this layout">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Close" Width="85" Height="28" IsCancel="True" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>

