<Window x:Class="SMS_Search.Views.Windows.ColumnPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SMS_Search.ViewModels.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ColumnPickerViewModel}"
        Title="{Binding Title}"
        Height="520" Width="760"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Status -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Double-click items to add/remove, or drag and drop in Selected Columns to reorder."
                       FontSize="12" Foreground="#555555" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FDECEA" BorderBrush="#D32F2F" BorderThickness="1" CornerRadius="3"
                Padding="8,5" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B71C1C" TextWrapping="Wrap" />
        </Border>

        <!-- Dual-List Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Available Columns -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Available Columns" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6" Padding="4,3"
                         ToolTip="Filter by column name or description" />

                <ListBox Grid.Row="2"
                         x:Name="AvailableListBox"
                         ItemsSource="{Binding FilteredAvailableColumns}"
                         SelectedItem="{Binding SelectedAvailableColumn}"
                         DisplayMemberPath="DisplayText"
                         MouseDoubleClick="AvailableListBox_MouseDoubleClick" />

                <Border Grid.Row="2" Background="#80FFFFFF"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading columns..." HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="#333333" />
                </Border>
            </Grid>

            <!-- Add / Remove Buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Command="{Binding AddSelectedCommand}" Content="&gt;" Width="34" Height="30"
                        Margin="0,0,0,8" ToolTip="Add selected column" FontWeight="Bold" />
                <Button Command="{Binding RemoveSelectedCommand}" Content="&lt;" Width="34" Height="30"
                        ToolTip="Remove selected column" FontWeight="Bold" />
            </StackPanel>

            <!-- Selected Columns -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Selected Columns (Order)" FontWeight="SemiBold" Margin="0,0,0,6" />

                <ListBox Grid.Row="1"
                         x:Name="SelectedListBox"
                         ItemsSource="{Binding SelectedColumns}"
                         SelectedItem="{Binding SelectedChosenColumn}"
                         DisplayMemberPath="DisplayText"
                         AllowDrop="True"
                         MouseDoubleClick="SelectedListBox_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="SelectedListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="SelectedListBox_PreviewMouseMove"
                         DragOver="SelectedListBox_DragOver"
                         DragLeave="SelectedListBox_DragLeave"
                         Drop="SelectedListBox_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                    <Setter Property="Foreground" Value="#D32F2F" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Reorder Buttons -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Command="{Binding MoveUpCommand}" Content="▲" Width="34" Height="30"
                        Margin="0,0,0,8" ToolTip="Move Up" />
                <Button Command="{Binding MoveDownCommand}" Content="▼" Width="34" Height="30"
                        ToolTip="Move Down" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Command="{Binding ResetDefaultsCommand}"
                    Content="Reset Defaults" Padding="12,5" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" Content="Cancel" Width="80" Height="28"
                        Margin="0,0,8,0" IsCancel="True" />
                <Button Command="{Binding ConfirmCommand}" Content="OK" Width="80" Height="28"
                        IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

