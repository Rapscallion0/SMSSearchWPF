<Window x:Class="SMS_Search.Views.Windows.StartupSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:SMS_Search.Views.Controls"
        xmlns:conv="clr-namespace:SMS_Search.Converters"
        xmlns:utils="clr-namespace:SMS_Search.Utils"
        mc:Ignorable="d"
        Title="SMS Search - Initial Setup"
        SizeToContent="Height" Width="860" MinWidth="700" MinHeight="560" MaxHeight="820"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                BorderBrush="#66888888"
                                BorderThickness="1.5"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotOuter" Width="14" Height="14" Stroke="#888888" StrokeThickness="1.5" Margin="0,2,8,0" VerticalAlignment="Top">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="Transparent" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="CardBorder" Property="Background" Value="#150078D7" />
                                <Setter TargetName="DotOuter" Property="Stroke" Value="#0078D7" />
                                <Setter TargetName="DotOuter" Property="Fill" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvalidRedBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Red" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Welcome to SMS Search" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Choose how you want to load database metadata and run searches:"
                       TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Step 1: 3 Mode Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="ModeDbRadio" Grid.Column="0" Style="{StaticResource ModeCardStyle}"
                         GroupName="SetupMode" Checked="ModeRadio_Checked">
                <StackPanel>
                    <TextBlock Text="SQL Server Database" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Use RB_TABLES / RB_FIELDS &amp; query live data." TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeCsvRadio" Grid.Column="1" Style="{StaticResource ModeCardStyle}"
                         GroupName="SetupMode" Checked="ModeRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Fields.csv Dictionary" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Offline mode. No SQL Server required." TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ModeBothRadio" Grid.Column="2" Style="{StaticResource ModeCardStyle}"
                         GroupName="SetupMode" Checked="ModeRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Both (SQL + Fields.csv)" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Live SQL queries enriched with Fields.csv." TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- Step 2: Dynamic Zero-Scroll Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DbColumn" Width="*" />
                <ColumnDefinition x:Name="SpacerColumn" Width="12" />
                <ColumnDefinition x:Name="CsvColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SQL Server Panel -->
            <GroupBox x:Name="DbGroupBox" Grid.Column="0" Header="Database Connection">
                <StackPanel Margin="8">
                    <ctrl:SettingControl Header="Server" IsSaved="{Binding Server.IsSaved}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <ComboBox Height="25" VerticalAlignment="Center"
                                              ItemsSource="{Binding Servers}"
                                              Text="{Binding Server.Value, UpdateSourceTrigger=LostFocus}"
                                              IsEditable="True" IsTextSearchEnabled="False" />
                                    <Border Style="{StaticResource InvalidRedBorderStyle}"
                                            Visibility="{Binding IsServerInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <Button Grid.Column="1" Content="?" Command="{Binding LoadServersCommand}"
                                        IsEnabled="{Binding IsLoadingServers, Converter={StaticResource InverseBooleanConverter}}"
                                        Margin="6,0,0,0" Padding="8,0" Height="25"
                                        ToolTip="{Binding ServerRefreshTooltip}" />
                            </Grid>
                            <CheckBox IsChecked="{Binding SearchNetworkServers.Value}" Content="Search for network servers" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding IsLoadingServers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar Width="90" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Searching for network servers..." FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ctrl:SettingControl>

                    <ctrl:SettingControl Header="Database" IsSaved="{Binding Database.IsSaved}">
                        <Grid>
                            <ComboBox Height="25" VerticalAlignment="Center"
                                      ItemsSource="{Binding Databases}"
                                      Text="{Binding Database.Value, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsServerInvalid, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                      IsEditable="True" IsTextSearchEnabled="False" />
                            <Border Style="{StaticResource InvalidRedBorderStyle}"
                                    Visibility="{Binding IsDatabaseInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ctrl:SettingControl>

                    <ctrl:SettingControl Header="Windows Authentication" IsSaved="{Binding WindowsAuth.IsSaved}">
                        <CheckBox IsChecked="{Binding WindowsAuth.Value, Mode=TwoWay}" VerticalAlignment="Center" />
                    </ctrl:SettingControl>

                    <ctrl:SettingControl Header="SQL User" IsSaved="{Binding User.IsSaved}"
                                         IsEnabled="{Binding WindowsAuth.Value, Converter={StaticResource InverseBooleanConverter}}">
                        <ctrl:ClearableTextBox Text="{Binding User.Value, UpdateSourceTrigger=PropertyChanged}" />
                    </ctrl:SettingControl>

                    <ctrl:SettingControl Header="SQL Password" IsSaved="{Binding IsPasswordSaved}"
                                         IsEnabled="{Binding WindowsAuth.Value, Converter={StaticResource InverseBooleanConverter}}">
                        <ctrl:ClearablePasswordBox Password="{Binding Password, Mode=TwoWay}" ShowEyeIcon="{Binding IsEditingPassword}" />
                    </ctrl:SettingControl>
                </StackPanel>
            </GroupBox>

            <!-- Fields.csv Panel -->
            <GroupBox x:Name="CsvGroupBox" Grid.Column="2" Header="Database Dictionary (Fields.csv)">
                <StackPanel Margin="8">
                    <ctrl:SettingControl Header="Fields.csv Path" IsSaved="{Binding DictionaryPath.IsSaved}">
                        <Grid utils:FileDropBehavior.EnableCsvDrop="True"
                              utils:FileDropBehavior.FileDroppedCommand="{Binding DropDictionaryFileCommand}">
                            <Rectangle StrokeDashArray="4 2" StrokeThickness="1.2" RadiusX="4" RadiusY="4" IsHitTestVisible="False">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Stroke" Value="#66888888" />
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(utils:FileDropBehavior.IsDragOver), RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Stroke" Value="#0078D7" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Fill" Value="#180078D7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <StackPanel Margin="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <ctrl:ClearableTextBox Text="{Binding DictionaryPath.Value, UpdateSourceTrigger=LostFocus}"
                                                               Placeholder="Drop Fields.csv here or Browse..."
                                                               ToolTip="Drop Fields.csv here, browse, or leave blank to auto-detect beside the executable" />
                                        <Border Style="{StaticResource InvalidRedBorderStyle}"
                                                Visibility="{Binding IsDictionaryPathInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseDictionaryCommand}" Margin="6,0,0,0" Padding="10,2" />
                                    <Button Grid.Column="2" Content="Copy to App" Command="{Binding CopyDictionaryToAppFolderCommand}"
                                            Visibility="{Binding CanCopyDictionaryToAppFolder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="4,0,0,0" Padding="8,2"
                                            ToolTip="Copy Fields.csv (and companion files) into the application folder" />
                                    <Button Grid.Column="3" Content="Auto" Command="{Binding ClearDictionaryPathCommand}" Margin="4,0,0,0" Padding="8,2"
                                            ToolTip="Revert to auto-detecting Fields.csv beside the executable" />
                                </Grid>
                                <TextBlock Text="Drag &amp; drop a Fields.csv file or folder here"
                                           FontSize="10.5" Opacity="0.65" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </ctrl:SettingControl>

                    <TextBlock Text="Tip: Placing Fields.csv (and optional Fields2.csv / Fields.es) in the same folder as the executable will detect and use it automatically."
                               TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,2,0,8" />

                    <TextBlock Text="{Binding DictionaryStatusText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Gray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDictionaryPathInvalid}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDictionaryError}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ctrl:SettingControl Header="Primary Language" IsSaved="{Binding DictionaryLanguage.IsSaved}">
                        <ComboBox ItemsSource="{Binding DictionaryLanguages}" SelectedItem="{Binding DictionaryLanguage.Value}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ctrl:SettingControl>
                </StackPanel>
            </GroupBox>
        </Grid>
        </ScrollViewer>

        <TextBlock x:Name="ValidationMessage" Grid.Row="3"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Continue" Width="95" Height="28" Margin="0,0,8,0" IsDefault="True" Click="ContinueButton_Click" />
            <Button Content="Exit" Width="80" Height="28" IsCancel="True" Click="ExitButton_Click" />
        </StackPanel>
    </Grid>
</Window>
