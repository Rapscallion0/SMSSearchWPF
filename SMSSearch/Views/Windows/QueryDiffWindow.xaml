<Window x:Class="SMS_Search.Views.Windows.QueryDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Query Formatting Comparison"
        Height="460" Width="760"
        MinHeight="340" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderTextBlock" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Existing Saved Formatting" Padding="6">
                <TextBox x:Name="ExistingSqlBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="4"/>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="New Editor Formatting" Padding="6">
                <TextBox x:Name="NewSqlBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="4"/>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UseNewButton" Content="Use New Formatting" Padding="12,5" Margin="0,0,8,0" Click="UseNewButton_Click"/>
            <Button x:Name="SaveNewCopyButton" Content="Save as New Copy" Padding="12,5" Margin="0,0,8,0" Click="SaveNewCopyButton_Click" Visibility="Collapsed"/>
            <Button Content="Keep Existing" Padding="12,5" IsCancel="True" Click="KeepExistingButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

