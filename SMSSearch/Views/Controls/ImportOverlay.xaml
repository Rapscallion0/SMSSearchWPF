<UserControl x:Class="SMS_Search.Views.Controls.ImportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SMS_Search.Views.Controls"
             xmlns:conv="clr-namespace:SMS_Search.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#D9000000"
             AllowDrop="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Drop="UserControl_Drop"
             DragEnter="UserControl_DragEnter">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Separate shadow layer so DropShadowEffect does not rasterize child text -->
        <Border Background="White" CornerRadius="8" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
        </Border>

        <Border Background="White" CornerRadius="8" Padding="20" MinWidth="450" MaxWidth="600"
                BorderBrush="#CCC" BorderThickness="1">

            <StackPanel>
                <TextBlock Text="Import Tables" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <Border x:Name="DropZone" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="5" Background="#F0F8FF" Padding="20" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Drag and Drop .sql files here" FontSize="16" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="or" HorizontalAlignment="Center" Foreground="#888" Margin="0,0,0,10"/>
                        <Button Content="Browse for Files" Command="{Binding BrowseFilesCommand}" Padding="15,5" HorizontalAlignment="Center"/>

                        <ItemsControl ItemsSource="{Binding SelectedFiles}" Margin="0,15,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#333" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Target Database:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="DBUSER_" VerticalAlignment="Center" Foreground="#555" Margin="0,0,2,0"/>
                        <ComboBox ItemsSource="{Binding TargetDatabases}" Text="{Binding TargetDatabaseSuffix, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="200" Padding="2" ToolTip="Enter a suffix or select an existing one"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                        <CheckBox Content="Use template database" IsChecked="{Binding UseTemplateDatabase}" IsEnabled="{Binding CanChangeTemplateDatabase}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="TemplateInfoButton" Width="20" Height="20" Margin="6,0,0,0" Padding="0"
                                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand"
                                      ToolTip="Click for details about Template Database">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="2">
                                        <Control Template="{StaticResource Icon_Info}" Width="16" Height="16"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=TemplateInfoButton}"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=TemplateInfoButton}"
                               Placement="Bottom"
                               AllowsTransparency="True">
                            <Grid Margin="6">
                                <Border Background="White" CornerRadius="6" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="340">
                                    <StackPanel>
                                        <TextBlock Text="Template Database" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333" Margin="0,0,0,6">
                                            <Run Text="When checked: " FontWeight="SemiBold"/>
                                            <Run Text="Copies RB_FIELDS and RB_TABLES (for field descriptions and metadata) and uses the template database's exact column data types when creating tables."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333">
                                            <Run Text="When unchecked: " FontWeight="SemiBold"/>
                                            <Run Text="Creates tables by inferring column names and data types directly from the .sql files (no template database required)."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Popup>
                    </StackPanel>

                    <TextBlock Text="Template Database:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding TemplateDatabaseName}" IsEnabled="{Binding CanSelectTemplateDatabase}" ToolTipService.ShowOnDisabled="True" Grid.Row="4" Grid.Column="1" Padding="2">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="ToolTip" Value="Select the database to copy the base schema and table structures from" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChangeTemplateDatabase}" Value="False">
                                        <Setter Property="ToolTip" Value="Cannot change Template database for an existing target database" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UseTemplateDatabase}" Value="False">
                                        <Setter Property="ToolTip" Value="Enable 'Use template database' to select a template database" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>

                <Border Visibility="{Binding UseTemplateDatabase, Converter={StaticResource BoolToVis}}"
                        Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Control Template="{StaticResource Icon_Info}" Width="14" Height="14" Margin="0,1,6,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Recommended: Ensure the template database and imported .sql files are from the same version."
                                   Foreground="#795548" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <CheckBox Content="Confirm inferred column types before creating tables" IsChecked="{Binding ConfirmInferredTypes}" Margin="0,0,0,10">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseTemplateDatabase}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <CheckBox Content="Switch to imported database after completion" IsChecked="{Binding SwitchToDatabaseAfterImport}" Margin="0,0,0,20"/>

                <!-- Progress Section -->
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                    <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="10" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ProgressStatusText}" Foreground="#555" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Delete Database" Command="{Binding DeleteDatabaseCommand}" Padding="15,5" Foreground="White" Background="#F44336" BorderThickness="0" Grid.Column="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#EF9A9A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChangeTemplateDatabase}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,5" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Import" Command="{Binding ImportCommand}" Padding="15,5" Background="#2196F3" Foreground="White" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#A0C8EF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
