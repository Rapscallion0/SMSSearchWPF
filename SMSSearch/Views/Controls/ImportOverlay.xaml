<UserControl x:Class="SMS_Search.Views.Controls.ImportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SMS_Search.Views.Controls"
             xmlns:conv="clr-namespace:SMS_Search.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#D9000000"
             AllowDrop="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Drop="UserControl_Drop"
             DragEnter="UserControl_DragEnter">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Separate shadow layer so DropShadowEffect does not rasterize child text -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20" MinWidth="450" MaxWidth="600"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1">

            <StackPanel>
                <TextBlock Text="Import Tables" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <Border x:Name="DropZone" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}" Padding="20" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Drag and Drop .sql files here" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="or" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                        <Button Content="Browse for Files" Command="{Binding BrowseFilesCommand}" Padding="15,5" HorizontalAlignment="Center"/>

                        <ItemsControl ItemsSource="{Binding SelectedFiles}" Margin="0,15,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Target Database:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="DBUSER_" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,2,0"/>
                        <ComboBox ItemsSource="{Binding TargetDatabases}" Text="{Binding TargetDatabaseSuffix, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="200" Padding="2" ToolTip="Enter a suffix or select an existing one"/>
                    </StackPanel>

                    <TextBlock Text="Schema Source:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton Content="Template Database" IsChecked="{Binding IsTemplateSource}" IsEnabled="{Binding CanChangeTemplateDatabase}" GroupName="ImportSchemaSource" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <RadioButton Content="Fields.csv" IsChecked="{Binding IsFieldsCsvSource}" IsEnabled="{Binding CanChangeTemplateDatabase}" GroupName="ImportSchemaSource" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <RadioButton Content="Infer from .sql" IsChecked="{Binding IsInferSource}" IsEnabled="{Binding CanChangeTemplateDatabase}" GroupName="ImportSchemaSource" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="TemplateInfoButton" Width="20" Height="20" Margin="6,0,0,0" Padding="0"
                                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand"
                                      ToolTip="Click for details about Schema Sources">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="2">
                                        <Control Template="{StaticResource Icon_Info}" Width="16" Height="16"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=TemplateInfoButton}"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=TemplateInfoButton}"
                               Placement="Bottom"
                               AllowsTransparency="True">
                            <Grid Margin="6">
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="360">
                                    <StackPanel>
                                        <TextBlock Text="Import Schema Source" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6">
                                            <Run Text="Template Database: " FontWeight="SemiBold"/>
                                            <Run Text="Copies RB_FIELDS and RB_TABLES and uses the template database's exact column data types."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6">
                                            <Run Text="Fields.csv: " FontWeight="SemiBold"/>
                                            <Run Text="Resolves column types from Fields.csv (and prompts only for columns missing from Fields.csv)."/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}">
                                            <Run Text="Infer from .sql: " FontWeight="SemiBold"/>
                                            <Run Text="Infers column names and data types directly from the .sql files."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Popup>
                    </StackPanel>

                    <TextBlock Text="Template Database:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,0,10,0"
                               Visibility="{Binding IsTemplateSource, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding TemplateDatabaseName}" IsEnabled="{Binding CanSelectTemplateDatabase}" ToolTipService.ShowOnDisabled="True" Grid.Row="4" Grid.Column="1" Padding="2"
                              Visibility="{Binding IsTemplateSource, Converter={StaticResource BoolToVis}}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="ToolTip" Value="Select the database to copy the base schema and table structures from" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChangeTemplateDatabase}" Value="False">
                                        <Setter Property="ToolTip" Value="Cannot change Template database for an existing target database" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UseTemplateDatabase}" Value="False">
                                        <Setter Property="ToolTip" Value="Enable 'Use template database' to select a template database" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>

                <Border Visibility="{Binding UseTemplateDatabase, Converter={StaticResource BoolToVis}}"
                        Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Control Template="{StaticResource Icon_Info}" Width="14" Height="14" Margin="0,1,6,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Recommended: Ensure the template database and imported .sql files are from the same version."
                                   Foreground="#795548" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsFieldsCsvSource, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fields.csv:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ActiveFieldsCsvDisplay, Mode=OneWay}" IsReadOnly="True" Height="24" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="{Binding ActiveFieldsCsvDisplay}"/>
                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseFieldsCsvCommand}" Padding="10,3"/>
                    </Grid>
                    <CheckBox Content="Populate RB_FIELDS &amp; RB_TABLES in target database from Fields.csv"
                              IsChecked="{Binding PopulateDictionaryTables}"
                              ToolTip="Creates RB_FIELDS and RB_TABLES in the target DBUSER_* database using Fields.csv"/>
                </StackPanel>

                <CheckBox Content="Confirm inferred column types before creating tables" IsChecked="{Binding ConfirmInferredTypes}" Margin="0,0,0,10">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInferSource}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <CheckBox Content="Switch to imported database after completion" IsChecked="{Binding SwitchToDatabaseAfterImport}" Margin="0,0,0,20"/>

                <!-- Progress Section -->
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                    <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="10" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ProgressStatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Delete Database" Command="{Binding DeleteDatabaseCommand}" Padding="15,5" Foreground="White" Background="#F44336" BorderThickness="0" Grid.Column="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#EF9A9A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChangeTemplateDatabase}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,5" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Import" Command="{Binding ImportCommand}" Padding="15,5" Background="#2196F3" Foreground="White" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1976D2"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#A0C8EF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
