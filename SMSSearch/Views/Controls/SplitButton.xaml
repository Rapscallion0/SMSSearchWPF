<UserControl x:Class="SMS_Search.Views.Controls.SplitButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="SplitSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="OuterBorder"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushKey}"
            BorderThickness="1"
            CornerRadius="4"
            Height="24">
        <StackPanel Orientation="Horizontal">
            <Button Content="{Binding Text, ElementName=Root}"
                    Command="{Binding PrimaryCommand, ElementName=Root}"
                    ToolTip="{Binding PrimaryToolTip, ElementName=Root}"
                    Padding="8,0"
                    Style="{StaticResource SplitSegmentButtonStyle}"/>
            <Border Width="1" Background="{DynamicResource BorderBrushKey}" VerticalAlignment="Stretch"/>
            <Button x:Name="DropdownButton"
                    Content="▾"
                    Padding="5,0"
                    ToolTip="More options"
                    Click="DropdownButton_Click"
                    Style="{StaticResource SplitSegmentButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="DropdownMenu">
                        <MenuItem x:Name="SecondaryMenuItem"
                                  Header="{Binding SecondaryText}"
                                  Command="{Binding SecondaryCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </Border>
</UserControl>

