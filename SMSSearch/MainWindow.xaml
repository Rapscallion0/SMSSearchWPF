<Window x:Class="SMS_Search.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMS_Search"
        xmlns:views="clr-namespace:SMS_Search.Views"
        xmlns:panels="clr-namespace:SMS_Search.Views.Panels"
        xmlns:controls="clr-namespace:SMS_Search.Views.Controls"
        xmlns:vm="clr-namespace:SMS_Search.ViewModels"
        xmlns:conv="clr-namespace:SMS_Search.Converters"
        xmlns:utils="clr-namespace:SMS_Search.Utils"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}" Height="757" Width="1017"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Resources/SMS Search.ico" MinWidth="338" MinHeight="95">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <conv:DictionarySourceShortConverter x:Key="DictionarySourceShortConverter"/>

        <utils:WorkspaceLayoutTemplateSelector x:Key="WorkspaceTemplateSelector">
            <utils:WorkspaceLayoutTemplateSelector.DocumentTemplate>
                <DataTemplate DataType="{x:Type vm:ResultTabViewModel}">
                    <views:ResultsView DataContext="{Binding ResultsVm}"/>
                </DataTemplate>
            </utils:WorkspaceLayoutTemplateSelector.DocumentTemplate>
        </utils:WorkspaceLayoutTemplateSelector>

        <utils:WorkspaceLayoutStyleSelector x:Key="WorkspaceStyleSelector">
            <utils:WorkspaceLayoutStyleSelector.DocumentStyle>
                <Style TargetType="{x:Type avalonDock:LayoutItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}"/>
                    <Setter Property="CanClose" Value="{Binding Model.CanClose}"/>
                    <Setter Property="CanFloat" Value="True"/>
                </Style>
            </utils:WorkspaceLayoutStyleSelector.DocumentStyle>
        </utils:WorkspaceLayoutStyleSelector>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding ExecuteCustomSqlCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Alt+Shift" Command="{Binding UnlockEncryptionUtilityCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
              BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="New Results Tab" Command="{Binding NewTabCommand}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="Close Active Tab" Command="{Binding CloseActiveTabCommand}" InputGestureText="Ctrl+W"/>
                <Separator/>
                <MenuItem Header="Import Tables..." Command="{Binding OpenImportCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="_Search">
                <MenuItem Header="Run Search Criteria" Command="{Binding SearchCommand}" InputGestureText="F5"/>
                <MenuItem Header="Execute SQL Editor" Command="{Binding ExecuteCustomSqlCommand}" InputGestureText="Ctrl+Enter"/>
                <Separator/>
                <MenuItem Header="Refresh Databases" Command="{Binding RefreshDatabasesCommand}"/>
                <MenuItem Header="Refresh Tables &amp; IntelliSense" Command="{Binding SearchVm.RefreshTablesCommand}"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Panels" SubmenuOpened="PanelsMenu_SubmenuOpened">
                    <MenuItem x:Name="MenuPanelSearchCriteria" Header="Search Criteria" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="SearchCriteria"/>
                    <MenuItem x:Name="MenuPanelSqlEditor" Header="SQL Editor" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="SqlEditor"/>
                    <MenuItem x:Name="MenuPanelResults" Header="Results" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="Results"/>
                    <MenuItem x:Name="MenuPanelRowInspector" Header="Row Inspector" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="RowInspector"/>
                    <MenuItem x:Name="MenuPanelSavedQueries" Header="Saved Queries" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="SavedQueries"/>
                    <MenuItem x:Name="MenuPanelSelectionStats" Header="Selection Statistics" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="SelectionStats"/>
                    <MenuItem x:Name="MenuPanelDateConverter" Header="Date Converter" IsCheckable="True" Click="TogglePanelMenu_Click" Tag="DateConverter"/>
                </MenuItem>
                <MenuItem Header="Theme">
                    <MenuItem Header="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                    <MenuItem Header="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                    <MenuItem Header="System" Command="{Binding SetThemeCommand}" CommandParameter="System"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Manage Layouts..." Click="ManageLayoutsMenu_Click"/>
            </MenuItem>

            <MenuItem Header="_Tools" SubmenuOpened="ToolsMenu_SubmenuOpened">
                <MenuItem Header="GS1 Toolkit..." Command="{Binding OpenGs1ToolkitCommand}"/>
                <MenuItem Header="Unarchive Drop Target" IsCheckable="True" IsChecked="{Binding IsUnarchiveTargetVisible, Mode=OneWay}" Command="{Binding OpenUnarchiveCommand}"/>
                <MenuItem x:Name="MenuEncryptionUtility" Header="Encryption Utility..."
                          Command="{Binding OpenEncryptionUtilityCommand}"
                          Visibility="Collapsed"/>
                <Separator/>
                <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Dockable Workspace -->
        <avalonDock:DockingManager x:Name="DockManager"
                                   Grid.Row="1"
                                   Validation.ErrorTemplate="{x:Null}"
                                   LayoutChanged="DockManager_LayoutChanged"
                                   utils:DockingSplitterBehavior.IsolateAdjacentResize="True"
                                   utils:FloatingWindowSnapBehavior.EnableWindowSnap="True"
                                   AllowMixedOrientation="True">
            <avalonDock:DockingManager.AnchorableHeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"
                               ToolTip="{Binding Title}"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </avalonDock:DockingManager.AnchorableHeaderTemplate>
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockHeight="1.1500560948067564*" DockMinWidth="665" DockMinHeight="317">
                            <avalonDock:LayoutAnchorablePane DockHeight="1.1674590678963015*" DockMinWidth="665" DockMinHeight="170">
                                <avalonDock:LayoutAnchorable x:Name="PaneSearchCriteria" ContentId="SearchCriteria" Title="Search Criteria">
                                    <views:SearchView DataContext="{Binding SearchVm}" VerticalAlignment="Stretch"/>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                            <avalonDock:LayoutAnchorablePane DockHeight="0.8110994080777051*" DockMinWidth="349" DockMinHeight="142">
                                <avalonDock:LayoutAnchorable x:Name="PaneSqlEditor" ContentId="SqlEditor" Title="SQL Editor">
                                    <panels:SqlEditorPanelView/>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>

                        <avalonDock:LayoutAnchorablePane DockHeight="0.8340988075967033*" DockMinWidth="547" DockMinHeight="218">
                            <avalonDock:LayoutAnchorable x:Name="PaneResults" ContentId="Results" Title="Results" CanClose="False">
                                <panels:ResultsPanelView/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>

                    <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="274" DockMinWidth="274" DockMinHeight="503">
                        <avalonDock:LayoutAnchorablePane DockHeight="1.483671912230985*" DockMinWidth="274" DockMinHeight="397">
                            <avalonDock:LayoutAnchorable x:Name="PaneRowInspector" ContentId="RowInspector" Title="Row Inspector">
                                <panels:RowInspectorPanelView/>
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="PaneSavedQueries" ContentId="SavedQueries" Title="Saved Queries">
                                <panels:SavedQueriesPanelView/>
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="PaneSelectionStats" ContentId="SelectionStats" Title="Selection Statistics">
                                <panels:SelectionStatsPanelView/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane DockHeight="0.29095882111828164*" DockMinWidth="229" DockMinHeight="101">
                            <avalonDock:LayoutAnchorable x:Name="PaneDateConverter" ContentId="DateConverter" Title="Date Converter">
                                <panels:DateConverterPanelView/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutAnchorablePaneGroup>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <!-- Clean Status Bar -->
        <StatusBar Grid.Row="2" x:Name="MainStatusBar" SizeChanged="MainStatusBar_SizeChanged"
                   BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <StackPanel x:Name="LeftStatusPanel" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding ActiveProfile, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Visibility="{Binding HasMultipleProfiles, Converter={StaticResource BoolToVis}}"
                              MinWidth="110" Height="22" Margin="0,0,6,0" FontSize="11"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip="Switch Connection Profile"/>

                    <Border Visibility="{Binding HasEnvironmentBadge, Converter={StaticResource BoolToVis}}"
                            CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Active Connection Environment">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF555555"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveEnvironmentTag}" Value="Dev">
                                        <Setter Property="Background" Value="#FF2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveEnvironmentTag}" Value="Qa">
                                        <Setter Property="Background" Value="#FFEF6C00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveEnvironmentTag}" Value="Prod">
                                        <Setter Property="Background" Value="#FFC62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ActiveEnvironmentBadgeText}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                    </Border>

                    <TextBlock x:Name="DatabaseLabel" Text="Database:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DatabaseComboBox" MinWidth="160" Height="22" VerticalAlignment="Center"
                              ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                              IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              PreviewKeyDown="DatabaseComboBox_PreviewKeyDown" KeyUp="DatabaseComboBox_KeyUp" GotFocus="DatabaseComboBox_GotFocus"
                              PreviewMouseDoubleClick="DatabaseComboBox_PreviewMouseDoubleClick" LostFocus="DatabaseComboBox_LostFocus">
                    </ComboBox>

                    <Button Command="{Binding RefreshDatabasesCommand}" Style="{StaticResource TransparentIconButtonStyle}" ToolTip="Refresh Databases" Margin="5,0,0,0" Width="20" Height="20">
                        <Control Template="{StaticResource Icon_Refresh}" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                            <Control.Style>
                                <Style TargetType="Control">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshingDatabases}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SpinStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Control.Style>
                        </Control>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0,8,0"/>

                    <ComboBox ItemsSource="{Binding ResultsVm.DictionarySourceModes}"
                              SelectedItem="{Binding ResultsVm.SelectedDictionarySource}"
                              ToolTip="{Binding ResultsVm.DictionaryStatusTooltip}"
                              Height="22" MinWidth="58" Padding="6,0" FontSize="11"
                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DictionarySourceShortConverter}}"
                                           ToolTip="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="MaskOverlay" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3"/>

        <controls:ImportOverlay Grid.RowSpan="3" DataContext="{Binding ImportVm}" Visibility="{Binding DataContext.IsImportTargetVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10"/>
    </Grid>
</Window>
