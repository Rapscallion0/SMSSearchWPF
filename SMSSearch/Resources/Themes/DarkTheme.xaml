<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window & Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF252526"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#FF3F3F46"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFB0B0B0"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF007ACC"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF333337"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF3E3E42"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF007ACC"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF555555"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="GridBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="GridRowBackgroundBrush" Color="#FF252526"/>
    <SolidColorBrush x:Key="GridAltRowBackgroundBrush" Color="#FF2A2A2D"/>
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="GridSelectionBrush" Color="#FF264F78"/>
    <SolidColorBrush x:Key="GridSelectionBorderBrush" Color="#FF007ACC"/>
    <SolidColorBrush x:Key="GridSelectionTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FF3F3F46"/>

    <!-- StatusBar & Editor -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF252526"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#FFD4D4D4"/>

    <!-- Icons -->
    <SolidColorBrush x:Key="IconGearOuterBrush" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="IconGearInnerBrush" Color="#FF3E3E42"/>

    <!-- SystemColors overrides for native WPF / AvalonEdit popups & controls -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF333337"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF3E3E42"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF264F78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3D41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF888888"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFF1F1F1"/>
</ResourceDictionary>
